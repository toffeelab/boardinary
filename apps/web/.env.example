# Database (Auth.js 전용 — 비즈니스 데이터는 NestJS API를 통해 접근)
DATABASE_URL=postgresql://boardinary:boardinary@localhost:6432/boardinary

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=onboarding@resend.dev

# NestJS API
API_URL=http://localhost:4001
INTERNAL_API_SECRET=generate-with-openssl-rand-base64-32

# App
NEXT_PUBLIC_APP_URL=http://localhost:4000
